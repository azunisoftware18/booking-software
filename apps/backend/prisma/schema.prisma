generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// USER
model User {
  id       String  @id @default(uuid())
  fullName String  @map("full_name")
  email    String  @unique
  password String?

  refreshToken String? @map("refresh_token")
  phone        String?

  roleId  String  @map("role_id")
  placeId String? @map("place_id")

  // Only parent ID is stored in the database
  parentId String? @map("parent_id")
  level    Int     @default(1)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  role  Role   @relation(fields: [roleId], references: [id])
  place Place? @relation(fields: [placeId], references: [id])
  createdPlaces Place[] @relation("PlaceCreator")
  createdTicketTypes TicketType[] @relation("TicketTypeCreator")
  createdLocations Location[] @relation("LocationCreator")
  createdRoles Role[] @relation("RoleCreator")

  // Prisma relations; no child ID column is created
  parent   User?  @relation("UserHierarchy", fields: [parentId], references: [id])
  children User[] @relation("UserHierarchy")

  tickets  Ticket[]  
  bookings Booking[] 

  assignedPermissions AssignedPermission[]
  location            Location?            @relation(fields: [locationId], references: [id])
  locationId          String?

  @@index([roleId])
  @@index([placeId])
  @@index([parentId])
  @@index([level])
  @@map("users")
}

model Place {
  id               String  @id @default(uuid())
  createdById      String? @map("created_by_id")
  name             String
  location         String?
  latitude         Float?
  longitude        Float?
  imageUrl         String?
  imageKey         String?
  shortDescription String?
  description      String? @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketTypes   TicketType[]
  tickets       Ticket[]
  slotTemplates SlotTemplate[]
  slotOverrides SlotOverride[]
  bookings      Booking[]
  users         User[]
  createdBy     User?   @relation("PlaceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@unique([name, location])
  @@map("places")
}

// SLOT
model SlotTemplate {
  id      String @id @default(uuid())
  placeId String @map("place_id")

  startTime String @map("start_time")
  endTime   String @map("end_time")
  capacity  Int    @map("capacity")

  place Place @relation(fields: [placeId], references: [id])

  @@unique([placeId, startTime])
  @@map("slot_templates")
}

model SlotOverride {
  id String @id @default(uuid())

  placeId   String   @map("place_id")
  date      DateTime
  startTime String   @map("start_time")

  capacity Int?
  isClosed Boolean @default(false) @map("is_closed")

  place Place @relation(fields: [placeId], references: [id])

  @@unique([placeId, date, startTime])
  @@map("slot_overrides")
}

// TICKET TYPES
model TicketType {
  id      String @id @default(uuid())
  name    String
  center  String @default("Jaipur")
  price   Float
  taxPercent Float @default(0) @map("tax_percent")
  isAvailable Boolean @default(true) @map("is_available")
  placeId String @map("place_id")
  createdById String? @map("created_by_id")


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  place     Place    @relation(fields: [placeId], references: [id])
  createdBy User?    @relation("TicketTypeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tickets   Ticket[]

  @@unique([center, name, placeId])
  @@index([placeId])
  @@index([createdById])
  @@map("ticket_types")
}

model Booking {
  id String @id @default(uuid())

  userId       String?  @map("user_id")
  placeId      String   @map("place_id")
  slotDateTime DateTime @map("slot_date_time")

  bookingType BookingType @default(TICKET) @map("booking_type")

  name  String
  email String
  phone String

  totalAmount Float @map("total_amount")
  totalSeats  Int   @map("total_seats")

  status    String    @default("PENDING")
  expiresAt DateTime? @map("expires_at")

  txnId     String? @unique @map("txn_id")
  paymentId String? @map("payment_id")

  ticketPayload Json?         @map("ticket_payload")
  paymentMethod PaymentMethod @map("payment_method")

  ticketPdfUrl String? @map("ticket_pdf_url")
  ticketPdfKey String? @map("ticket_pdf_key")

  createdAt DateTime @default(now()) @map("created_at")

  tickets Ticket[]
  user    User?    @relation(fields: [userId], references: [id])
  place   Place    @relation(fields: [placeId], references: [id])

  @@map("bookings")
}

model Location {
  id          String  @id @default(cuid())
  createdById String? @map("created_by_id")
  name        String  @unique
  description String? @db.Text
  address     String?
  city        String?
  state       String?

  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  users     User[]
  createdBy User?   @relation("LocationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([status])
  @@index([city])
  @@map("locations")
}

// TICKET
model Ticket {
  id String @id @default(uuid())

  bookingId String  @map("booking_id")
  userId    String? @map("user_id")
  placeId   String  @map("place_id")

  slotDateTime DateTime @map("slot_date_time")
  typeId       String   @map("type_id")

  qrCode String @unique @map("qr_code")

  status String @default("PENDING") // PENDING, SCANNED, EXPIRED

  booking Booking    @relation(fields: [bookingId], references: [id])
  type    TicketType @relation(fields: [typeId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  user      User?     @relation(fields: [userId], references: [id])
  place     Place     @relation(fields: [placeId], references: [id])
  scanLogs  ScanLog[]

  @@map("tickets")
}

// GATE
model Gate {
  id   String   @id @default(uuid())
  name String
  type GateType

  // optional geo
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("gates")
}

// SCAN LOG
model ScanLog {
  id String @id @default(uuid())

  ticketId String   @map("ticket_id")
  gateId   String?  @map("gate_id")
  type     GateType

  scannedAt DateTime @default(now()) @map("scanned_at")

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("scan_logs")
}

model Setting {
  id String @id @default("global-setting")

  companyName String?
  email       String?
  phone       String?
  address     String? @db.LongText

  logo    String? // S3 URL
  logoKey String? // S3 Key

  socialLinks Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Role {
  id          String  @id @default(uuid())
  createdById String? @map("created_by_id")
  roleName    String  @unique @map("role_name")
  roleCode    String  @unique @map("role_code")
  description String? @db.LongText

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]
  createdBy User? @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  assignedPermissions AssignedPermission[]

  @@index([createdById])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  resource    String
  action      String
  serviceCode String? @map("service_code")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedPermissions AssignedPermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
  @@index([serviceCode])
  @@map("permissions")
}

model AssignedPermission {
  id String @id @default(uuid())

  permissionId String  @map("permission_id")
  roleId       String? @map("role_id")
  userId       String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role?      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([permissionId, roleId])
  @@unique([permissionId, userId])
  @@index([permissionId])
  @@index([roleId])
  @@index([userId])
  @@map("assigned_permissions")
}

enum GateType {
  ENTRY
  EXIT
}

enum BookingType {
  TICKET
  PASS
}

enum PaymentMethod {
  CASH
  UPI
  ONLINE
}
